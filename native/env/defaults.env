# AzuraCast-LXC default settings.
# These mirror the ENV defaults of the upstream Docker image (see Dockerfile).
# The installer copies them into /etc/azuracast/azuracast.env on first install and adds any
# new keys on update; edit that file, not this one, then run: azuracast-ctl restart
APPLICATION_ENV=production
TZ=UTC
LANG=en_US.UTF-8
LANGUAGE=en_US.UTF-8
LC_ALL=en_US.UTF-8
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=azuracast
MYSQL_DATABASE=azuracast
ENABLE_REDIS=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
NGINX_RADIO_PORTS=default
NGINX_WEBDJ_PORTS=default
COMPOSER_PLUGIN_MODE=false
ADDITIONAL_MEDIA_SYNC_WORKER_COUNT=0
PROFILING_EXTENSION_ENABLED=0
PROFILING_EXTENSION_ALWAYS_ON=0
PROFILING_EXTENSION_HTTP_KEY=dev
PROFILING_EXTENSION_HTTP_IP_WHITELIST=*
ENABLE_WEB_UPDATER=true
AUTO_ASSIGN_PORT_MIN=8000
AUTO_ASSIGN_PORT_MAX=8499
SHOW_DETAILED_ERRORS=false
AZURACAST_HTTP_PORT=80
AZURACAST_HTTPS_PORT=443
AZURACAST_SFTP_PORT=2022
NGINX_BLOCK_BOTS=false
